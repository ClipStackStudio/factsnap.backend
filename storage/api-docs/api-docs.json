            "get": {
                "tags": [
                    "Packages"
                ],
                "summary": "Get a specific package with its category and facts",
                "description": "Display a specific package with its category and facts.",
                "operationId": "ae4e1772df8d6e55efccd5495f46921e",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Package UUID",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Package retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "allOf": [
                                                {
                                                    "$ref": "#/components/schemas/Package"
                                                },
                                                {
                                                    "properties": {
                                                        "category": {
                                                            "$ref": "#/components/schemas/Category"
                                                        },
                                                        "facts": {
                                                            "type": "array",
                                                            "items": {
                                                                "$ref": "#/components/schemas/Fact"
                                                            }
                                                        }
                                                    },
                                                    "type": "object"
                                                }
                                            ]
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Package not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                }
            }
        }
