            "get": {
                "tags": [
                    "Packages"
                ],
                "summary": "Get all packages with their category",
                "description": "Display all packages with their category.",
                "operationId": "f550ff7f3b3ca5455c8a5b640d119d43",
                "responses": {
                    "200": {
                        "description": "Packages retrieved successfully",
                        "content": {
