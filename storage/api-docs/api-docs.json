{
    "openapi": "3.0.0",
    "info": {
        "title": "Factsnap API",
        "description": "API for managing educational categories, packages, and facts",
        "contact": {
            "email": "support@factsnap.com"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api",
            "description": "Factsnap API Server"
        }
    ],
    "paths": {
        "/categories-only": {
            "get": {
                "tags": [
                    "Categories"
                ],
                "summary": "Get all categories without packages",
                "description": "Display all categories only (without packages).",
                "operationId": "404930bfc487f84d7add318d510e83c2",
                "responses": {
                    "200": {
                        "description": "Categories retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Category"
                                            }
                                        },
                                        "debug": {
                                            "properties": {
                                                "response_time_ms": {
                                                    "type": "number"
                                                },
                                                "from_cache": {
                                                    "type": "boolean"
                                                },
                                                "count": {
                                                    "type": "integer"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/categories": {
            "get": {
                "tags": [
                    "Categories"
                ],
                "summary": "Get all categories with their packages",
                "description": "Display all categories with their packages.",
                "operationId": "ead5fb1cf2a7453acb2e37928a1b1eaf",
                "responses": {
                    "200": {
                        "description": "Categories with packages retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "details": {
                                            "properties": {
                                                "total": {
                                                    "description": "Total number of categories",
                                                    "type": "integer"
                                                }
                                            },
                                            "type": "object"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "allOf": [
                                                    {
                                                        "$ref": "#/components/schemas/Category"
                                                    },
                                                    {
                                                        "properties": {
                                                            "packages": {
                                                                "type": "array",
                                                                "items": {
                                                                    "$ref": "#/components/schemas/Package"
                                                                }
                                                            }
                                                        },
                                                        "type": "object"
                                                    }
                                                ]
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/categories/{id}": {
            "get": {
                "tags": [
                    "Categories"
                ],
                "summary": "Get a specific category with its packages",
                "description": "Display a specific category with its packages.",
                "operationId": "4cdf41756315109f1efc72787db5830a",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Category UUID",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Category retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "allOf": [
                                                {
                                                    "$ref": "#/components/schemas/Category"
                                                },
                                                {
                                                    "properties": {
                                                        "packages": {
                                                            "type": "array",
                                                            "items": {
                                                                "$ref": "#/components/schemas/Package"
                                                            }
                                                        }
                                                    },
                                                    "type": "object"
                                                }
                                            ]
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Category not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/categories/{id}/packages": {
            "get": {
                "tags": [
                    "Categories"
                ],
                "summary": "Get all packages for a specific category",
                "description": "Get packages for a specific category.",
                "operationId": "3ca4881eed2808aa58267432e1308fa9",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Category UUID",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Packages retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "properties": {
                                                "category": {
                                                    "properties": {
                                                        "id": {
                                                            "type": "string",
                                                            "format": "uuid"
                                                        },
                                                        "name": {
                                                            "type": "string"
                                                        },
                                                        "icon_url": {
                                                            "type": "string"
                                                        }
                                                    },
                                                    "type": "object"
                                                },
                                                "packages": {
                                                    "type": "array",
                                                    "items": {
                                                        "$ref": "#/components/schemas/Package"
                                                    }
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Category not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/categories/filter/access-level": {
            "get": {
                "tags": [
                    "Categories"
                ],
                "summary": "Get categories filtered by package access level",
                "description": "Get categories with packages filtered by access level.",
                "operationId": "9e77e1f5d1f725b96762446adc7302aa",
                "parameters": [
                    {
                        "name": "access_level",
                        "in": "query",
                        "description": "Filter packages by access level",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "free",
                            "enum": [
                                "free",
                                "premium"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Filtered categories retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "allOf": [
                                                    {
                                                        "$ref": "#/components/schemas/Category"
                                                    },
                                                    {
                                                        "properties": {
                                                            "packages": {
                                                                "type": "array",
                                                                "items": {
                                                                    "$ref": "#/components/schemas/Package"
                                                                }
                                                            }
                                                        },
                                                        "type": "object"
                                                    }
                                                ]
                                            }
                                        },
                                        "filter": {
                                            "properties": {
                                                "access_level": {
                                                    "type": "string",
                                                    "example": "free"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/categories/clear-cache": {
            "post": {
                "tags": [
                    "Categories"
                ],
                "summary": "Clear categories cache",
                "description": "Clear the categories cache (useful when data is updated).",
                "operationId": "121fd20d0494dbd0624f3f2aa611131a",
                "responses": {
                    "200": {
                        "description": "Cache cleared successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "All categories cache cleared successfully"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
